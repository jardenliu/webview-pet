{
  "name": "webview-pet",
  "version": "0.1.0",
  "description": "Desktop pet (桌宠) library for Node.js and Bun, powered by @webviewjs/webview. Transparent always-on-top pet windows with webm alpha animation playback, drag/throw physics, speech bubbles, sleep, locks, menus and multi-pet support — fully controllable through plain functions.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun run scripts/build.ts",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "demo": "bun examples/basic.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "prepublishOnly": "bun run build && bun test tests/"
  },
  "keywords": [
    "desktop-pet",
    "pet",
    "webview",
    "desktop-toy",
    "floating-widget",
    "transparent-window",
    "bun",
    "桌宠",
    "desktop-companion"
  ],
  "author": "jardenliu <15915839707@163.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jardenliu/webview-pet.git"
  },
  "homepage": "https://jardenliu.github.io/webview-pet/",
  "bugs": {
    "url": "https://github.com/jardenliu/webview-pet/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@webviewjs/webview": "^0.6.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0",
    "vitepress": "^1.6.4",
    "vue": "^3.5.44"
  }
}
